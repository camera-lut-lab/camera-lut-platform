# Copy this file to .env locally. Never commit real credentials.
# Generate a long random value for internal Java-to-Python authentication.
AI_INTERNAL_TOKEN=replace-with-a-long-random-secret

# Configure these values in the Alibaba Cloud Model Studio console.
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=
